    {
      "parameters": {
        "content": "## Bright Smile CRM logger\nVapi sends an end-of-call report here after every call.\n- Builds one row per call: name, phone, lead status, summary, transcript, recording\n- Lead status: Booked / Urgent - call back / No answer / Follow up\n- Sheet needs these headers in row 1: Call Time, Call ID, Patient Name, Phone, Lead Status, Appointment Time, Reason, Summary, Transcript, Recording URL, Ended Reason, Duration (sec)",
        "height": 176,
        "width": 768,
        "color": 4
      },
      "id": "bc9c4e54-de9c-438b-b141-520a7a27ba5b",
      "name": "Sticky Note 122b696b",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -304,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const row = $('Build CRM Row').first().json;\nconst ai = $input.first().json || {};\nlet s = ai.text || ai.data || '';\nif (!s && ai.content && ai.content[0]) { s = ai.content[0].text || ''; }\ns = String(s).trim();\nreturn [{ json: Object.assign({}, row, { summary: s || row.summary || '' }) }];"
      },
      "id": "36ac3112-cc82-4d5f-be25-1cbd2417d2b5",
      "name": "Merge Summary Into Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
