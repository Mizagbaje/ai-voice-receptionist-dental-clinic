      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-call-report",
        "options": {}
      },
      "id": "2d36fb16-caf7-4fb4-9d8f-b94ea7f96cde",
      "name": "Vapi Call Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body || input;\nconst msg = body.message || {};\nif (msg.type !== 'end-of-call-report') { return []; }\n\nconst call = msg.call || {};\nconst artifact = msg.artifact || {};\nconst analysis = msg.analysis || {};\nconst transcript = String(msg.transcript || artifact.transcript || '');\nconst messages = artifact.messages || msg.messages || [];\nconst endedReason = String(msg.endedReason || call.endedReason || '');\n\nlet args = {};\nfor (const m of messages) {\n  const tc = m && m.toolCalls && m.toolCalls[0];\n  if (tc && tc.function && tc.function.name === 'book_appointment') {\n    let a = tc.function.arguments;\n    if (typeof a === 'string') { try { a = JSON.parse(a); } catch (e) { a = {}; } }\n    args = a || {};\n  }\n}\n\nconst booked = JSON.stringify(messages).includes('Appointment booked for');\nconst userText = transcript.split('\\n').filter(function (l) { return /^user:/i.test(l); }).join(' ');\nconst urgent = /urgent|severe pain|swelling|bleeding|emergency/i.test(userText);\nconst noAnswer = /voicemail|no-answer|did-not-answer|busy/i.test(endedReason);\n\nlet leadStatus = 'Follow up';\nif (booked) { leadStatus = 'Booked'; }\nelse if (urgent) { leadStatus = 'Urgent - call back'; }\nelse if (noAnswer) { leadStatus = 'No answer'; }\n\nreturn [{\n  json: {\n    callTime: msg.endedAt || new Date().toISOString(),\n    callId: call.id || '',\n    patientName: args.patient_name || '',\n    phone: (call.customer && call.customer.number) || args.phone || '',\n    leadStatus: leadStatus,\n    appointmentTime: booked ? (args.date_time || '') : '',\n    reason: args.reason || '',\n    summary: analysis.summary || msg.summary || '',\n    transcript: transcript.slice(0, 40000),\n    recordingUrl: msg.recordingUrl || artifact.recordingUrl || '',\n    endedReason: endedReason,\n    durationSeconds: msg.durationSeconds || ''\n  }\n}];"
      },
